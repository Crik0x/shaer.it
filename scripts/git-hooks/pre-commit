#!/bin/sh
# Controlli meccanici prima di ogni commit.
#
# Il principio: nota < lezione < regola < controllo meccanico < hook.
# Cio' che finisce qui non ha piu' bisogno di essere ricordato da nessuno.
#
# Attivazione (una volta sola):
#   git config core.hooksPath scripts/git-hooks

RADICE=$(git rev-parse --show-toplevel)
cd "$RADICE" || exit 1
BLOCCO=0

# ── 1 · Invariante del registro ────────────────────────────────────────────
# Ogni T-NNN aperto nel REGISTRO deve comparire in TODO.md: un task non puo'
# sparire da entrambi. Nasce da task realmente evaporati fra due commit.
if [ -f memoria/REGISTRO.md ] && [ -f memoria/TODO.md ]; then
  APERTI=$(grep -oE '^\| *(T-[0-9]{3}) *\|.*\| *(aperto|—|-)? *\| *$' memoria/REGISTRO.md 2>/dev/null \
           | grep -oE 'T-[0-9]{3}')
  for id in $APERTI; do
    if ! grep -q "$id" memoria/TODO.md; then
      echo "⛔ $id e' aperto nel REGISTRO ma non compare in TODO.md."
      BLOCCO=1
    fi
  done
fi

# ── 2 · Budget del metodo ──────────────────────────────────────────────────
# Il costo fisso non deve mangiarsi la finestra di contesto.
if command -v node >/dev/null 2>&1 && [ -f scripts/costo.mjs ]; then
  node scripts/costo.mjs --check || BLOCCO=1
fi

# ── 3 · Segreti ────────────────────────────────────────────────────────────
# Un token o una password che entra nel sorgente ci resta anche dopo la
# rimozione, perche' la storia git la conserva. Meglio non farcela entrare.
# Il pattern cerca VALORI, non parole: «service_role» in prosa o «sk_test_...»
# come placeholder di documentazione non sono segreti (falso positivo del
# 23/07 alla prima installazione: bloccava due file di soli esempi).
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
for f in $STAGED; do
  [ -f "$f" ] || continue
  case "$f" in scripts/git-hooks/*) continue ;; esac
  if grep -qE '(ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk_(live|test)_[A-Za-z0-9]{16,}|eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\.[A-Za-z0-9_-]{10,})' "$f" 2>/dev/null; then
    echo "⛔ $f contiene qualcosa che somiglia a un segreto. Spostalo in .env."
    BLOCCO=1
  fi
done

# ── 4 · Tetti della memoria ────────────────────────────────────────────────
# Avviso, non blocco: tre righe di troppo non devono sbarrare un commit urgente.
for f in memoria/STATO.md memoria/TODO.md memoria/LEZIONI.md; do
  [ -f "$f" ] || continue
  BYTE=$(wc -c < "$f" | tr -d ' ')
  if [ "$BYTE" -gt 15360 ]; then
    echo "⚠️  $f e' $BYTE byte, oltre i 15 KB. Da potare."
  fi
done

# ── 5 · Versionamento a mano ───────────────────────────────────────────────
# Il versionamento a mano nel nome del file: la strada per ritrovarsi 14 copie,
# alcune byte-identiche, e nessuna certezza su quale sia quella buona.
for f in $STAGED; do
  case "$f" in
    *_v[0-9]*.*|*\ v[0-9]*.*|*" (1)"*|*" (2)"*)
      echo "⚠️  $f ha una versione nel nome. Git versiona gia': serve davvero?"
      ;;
  esac
done

# ── 6 · Ogni task lascia un dossier ────────────────────────────────────────
# L'analisi di un task non deve morire con la sessione: e' la spesa piu' cara
# che si possa pagare due volte. Avviso e non blocco: un dossier mancante si
# scrive in chiusura, non deve fermare un commit intermedio.
if [ -f memoria/REGISTRO.md ] && [ -d dossier ]; then
  CHIUSI=$(grep -oE '^\| *T-[0-9]{3} *\|[^|]*\|[^|]*\| *fatto *\|' memoria/REGISTRO.md 2>/dev/null \
           | grep -oE 'T-[0-9]{3}')
  for id in $CHIUSI; do
    if ! grep -rqls "task:.*$id" dossier 2>/dev/null; then
      echo "⚠️  $id risulta fatto ma non ha un dossier. L'analisi si perde."
    fi
  done
fi

# ── 7 · Next 16: il Middleware si chiama Proxy ─────────────────────────────
# Next 16 ha rinominato Middleware → Proxy. Un middleware.ts a root non viene
# registrato e rompe il dev server con un 500 "Could not parse module
# middleware.ts" (attrito reale di T-004). Il file giusto e' proxy.ts.
for f in apps/qr/middleware.ts apps/qr/middleware.js apps/qr/src/middleware.ts apps/qr/src/middleware.js; do
  if [ -f "$f" ]; then
    echo "⛔ $f: in Next 16 il Middleware si chiama Proxy. Rinomina in proxy.ts (export 'proxy')."
    BLOCCO=1
  fi
done

# ── 8 · Frontmatter dei dossier ────────────────────────────────────────────
# MODELLO.md fissa 5 chiavi obbligatorie (tier, aree, stato, riporti, sessioni).
# L'ambiguita' con «livello» (lavoro.md §2-bis parla di livello, MODELLO fissa
# `tier`) ha prodotto 2 dossier non conformi (T-011, T-012) e rompe il grep-by-
# `aree` su cui si fonda il distillatore. L-005.
for f in $STAGED; do
  case "$f" in
    dossier/MODELLO.md|dossier/PATTERN.md) continue ;;
    dossier/*.md|dossier/archivio/*.md)
      [ -f "$f" ] || continue
      if grep -qE '^livello:' "$f"; then
        echo "⛔ $f usa 'livello:' — MODELLO.md vuole 'tier:'."
        BLOCCO=1
      fi
      for k in tier aree stato riporti sessioni; do
        if ! grep -qE "^$k:" "$f"; then
          echo "⛔ $f: manca la chiave frontmatter '$k:' (dossier/MODELLO.md)."
          BLOCCO=1
        fi
      done
      # Il dominio, non solo la presenza: 'stato' fuori enum (es. 'in-corso')
      # supera il check-presenza ma rompe i filtri per stato. L-009 (T-019).
      st=$(grep -E '^stato:' "$f" | head -1 | sed -E 's/^stato:[[:space:]]*//; s/[[:space:]]*$//')
      if [ -n "$st" ] && [ "$st" != "aperto" ] && [ "$st" != "chiuso" ]; then
        echo "⛔ $f: stato '$st' fuori enum (dossier/MODELLO.md: aperto|chiuso)."
        BLOCCO=1
      fi
      ;;
  esac
done

# ── 9 · Type-check di apps/qr ──────────────────────────────────────────────
# Un type-error Recharts e' arrivato fino al deploy Vercel (rosso) perche' nessun
# controllo locale girava `tsc` prima del commit (attrito reale di T-011). Se il
# commit tocca il TypeScript di apps/qr, si type-checka qui. Si ignorano gli
# errori nei tipi generati (.next/) e nelle dipendenze. L-004.
if echo "$STAGED" | grep -qE '^apps/qr/.*\.(ts|tsx)$'; then
  if command -v npx >/dev/null 2>&1; then
    TSCOUT=$( cd apps/qr && npx --no-install tsc --noEmit 2>&1 | grep -vE '^\.next/|node_modules/' )
    if echo "$TSCOUT" | grep -qE 'error TS'; then
      echo "⛔ apps/qr: type-check fallito (tsc --noEmit):"
      echo "$TSCOUT" | grep -E 'error TS' | head -10
      BLOCCO=1
    fi
  fi
fi

# ── 10 · Funzione nuova senza test (avviso) ────────────────────────────────
# Trappola distillata 3 volte (T-011, T-012 ×2): una funzione/RPC nuova committata
# senza test la ferma solo il revisore — un giro intero. Qui è AVVISO, non blocco:
# i trigger si provano per comportamento, non per nome, e un blocco crudo li
# falserebbe. Cerca il NOME della funzione nuova in un *.test.ts qualsiasi.
NAMES=""
for f in $STAGED; do
  [ -f "$f" ] || continue
  case "$f" in
    *.test.ts) continue ;;
    *.sql)        NAMES="$NAMES $(grep -oiE 'create (or replace )?function [a-z0-9_.]+' "$f" 2>/dev/null | sed -E 's/.* //; s/^public\.//')" ;;
    apps/qr/*.ts) NAMES="$NAMES $(grep -oE 'export function [A-Za-z0-9_]+' "$f" 2>/dev/null | sed -E 's/.* //')" ;;
  esac
done
for name in $NAMES; do
  [ -z "$name" ] && continue
  if ! grep -rqIE --include='*.test.ts' --exclude-dir=node_modules --exclude-dir=.next "\b$name\b" . 2>/dev/null; then
    echo "⚠️  funzione '$name' nuova: nessun *.test.ts la menziona. Coprila (anche per comportamento) o rimandala al task che la usa."
  fi
done

# ── 11 · Decisione [LOCKED] senza D-NNN in DECISIONI.md (avviso) ───────────
# Pattern distillato 3 volte (T-008, T-016, T-020): una decisione marcata [LOCKED]/
# «deciso» in un dossier o in TODO ma mai promossa a memoria/DECISIONI.md — resta
# prosa, si scopre mancante solo cercandola là. Avviso, non blocco: a volte la
# decisione vive legittimamente solo nel dossier. Guarda le righe AGGIUNTE. L-008.
DECISION_HIT=""
for f in $STAGED; do
  case "$f" in
    dossier/*.md|memoria/TODO.md)
      if git diff --cached -- "$f" | grep -qE '^\+.*(\[LOCKED|deciso \(202)'; then
        DECISION_HIT="$DECISION_HIT $f"
      fi ;;
  esac
done
if [ -n "$DECISION_HIT" ] && ! echo "$STAGED" | grep -qxF 'memoria/DECISIONI.md'; then
  echo "⚠️  decisione strutturale in:$DECISION_HIT — ma memoria/DECISIONI.md non è nel commit. Manca un D-NNN?"
fi

if [ "$BLOCCO" -ne 0 ]; then
  echo ""
  echo "Commit fermato. Per forzare in emergenza: git commit --no-verify"
  exit 1
fi
exit 0
